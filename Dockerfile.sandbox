# Dockerfile for Next.js 14 Sandbox Environment
# Optimized for fast startup with pre-installed dependencies

FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files
COPY sandbox-template/package.json sandbox-template/package-lock.json* ./
RUN npm install --legacy-peer-deps

# Development image for hot reload
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy the template structure
COPY --chown=nextjs:nodejs sandbox-template/package.json ./package.json
COPY --chown=nextjs:nodejs sandbox-template/next.config.mjs ./next.config.mjs
COPY --chown=nextjs:nodejs sandbox-template/tsconfig.json ./tsconfig.json
COPY --chown=nextjs:nodejs sandbox-template/tailwind.config.js ./tailwind.config.js
COPY --chown=nextjs:nodejs sandbox-template/postcss.config.js ./postcss.config.js
COPY --chown=nextjs:nodejs sandbox-template/app ./app

# Create user-project directory
RUN mkdir -p /app/user-project && chown nextjs:nodejs /app/user-project

USER nextjs

EXPOSE 3000

# Health check endpoint
HEALTHCHECK --interval=5s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Copy the startup script
COPY --chown=nextjs:nodejs sandbox-template/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Start the development server
CMD ["/app/start.sh"]
