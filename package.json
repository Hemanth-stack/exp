{
  "name": "enterprise-ai-app-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "sandbox:setup": "chmod +x setup-docker-sandbox.sh && ./setup-docker-sandbox.sh",
    "sandbox:build": "docker build -f Dockerfile.sandbox -t nextjs-sandbox:latest .",
    "sandbox:start": "docker-compose -f docker-compose.sandbox.yml up -d",
    "sandbox:stop": "docker-compose -f docker-compose.sandbox.yml down",
    "sandbox:clean": "docker ps -a --filter 'label=sandbox.session' -q | xargs -r docker rm -f",
    "sandbox:check": "chmod +x check-docker-sandbox.sh && ./check-docker-sandbox.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.50",
    "@anthropic-ai/sdk": "^0.20.0",
    "@mastra/core": "^0.24.6",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "ai": "^5.0.104",
    "bcryptjs": "^2.4.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.29.1",
    "lucide-react": "^0.294.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.5",
    "postgres": "^3.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "redis": "^4.6.11",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.17.0",
    "simple-git": "^3.21.0",
    "tailwind-merge": "^2.1.0",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dockerode": "^3.3.23",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.16",
    "drizzle-kit": "^0.20.7",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "node-loader": "^2.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
