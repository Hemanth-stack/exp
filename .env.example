# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/appbuilder

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# GitHub OAuth (for GitHub sign-in and repo sync)
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the callback URL to: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Docker Sandbox Configuration
DOCKER_ENABLED=true
DOCKER_CONTAINER_PORT_START=3001
DOCKER_CONTAINER_PORT_END=4000
SANDBOX_TIMEOUT_MINUTES=30
SANDBOX_MAX_MEMORY=512m
SANDBOX_MAX_CPU=0.5
SANDBOX_BASE_IMAGE=nextjs-sandbox:latest

# Container Limits (per user)
MAX_CONTAINERS_PER_USER=6
CONTAINER_TIMEOUT_MINUTES=30

# Application
NODE_ENV=development

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here
